<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= current_theme %>">
  <head>
    <title>CadOnline</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "grid", "themes", "layout", "topbar", "sidebar", "paper", "paper/ruled", "paper/blank", "paper/grid", "paper/kitalua", "document/controls", "editor", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if logged_in? %>
      <%= render "shared/topbar" %>
      <%= render "shared/sidebar" %>
    <% end %>

    <main class="<%= logged_in? ? 'main' : '' %>">
      <div class="main-inner">
        <% if flash[:notice].present? %><p class="flash-msg"><%= flash[:notice] %></p><% end %>
        <% if flash[:alert].present? %><p class="flash-msg flash-msg-alert"><%= flash[:alert] %></p><% end %>
        <%= yield %>
      </div>
    </main>
    <div class="confirm-modal" id="confirmModal" hidden>
      <div class="confirm-card">
        <p id="confirmModalText">Tem certeza?</p>
        <div class="confirm-actions">
          <button class="theme-btn" id="confirmModalCancel" type="button">Cancelar</button>
          <button class="theme-btn" id="confirmModalOk" type="button">Confirmar</button>
        </div>
      </div>
    </div>

    <%= yield :scripts %>
  </body>
</html>
