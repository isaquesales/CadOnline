<section class="auth-shell">
  <h2>Criar conta</h2>
  <%= form_with model: @user, url: signup_path, class: "auth-form" do |f| %>
    <label>Nome completo</label>
    <%= f.text_field :full_name, required: true, maxlength: 120, autocomplete: "name" %>
    <label>E-mail</label>
    <%= f.email_field :email, required: true, autocomplete: "email" %>
    <label>Senha</label>
    <%= f.password_field :password, required: true, minlength: 8, autocomplete: "new-password" %>
    <label>Confirme a senha</label>
    <%= f.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password" %>
    <label class="terms-check"><%= f.check_box :accepted_terms, required: true %> Aceito os termos e política de privacidade</label>
    <%= f.submit "Criar conta", class: "theme-btn" %>
  <% end %>
  <p><%= link_to "Já tenho conta", login_path %></p>
</section>
