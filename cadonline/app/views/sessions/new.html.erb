<section class="auth-shell">
  <h2>Entrar</h2>
  <%= form_with url: login_path, method: :post, class: "auth-form" do |f| %>
    <label>E-mail</label>
    <%= f.email_field :email, required: true, autocomplete: "email" %>
    <label>Senha</label>
    <%= f.password_field :password, required: true, autocomplete: "current-password" %>
    <%= f.submit "Entrar", class: "theme-btn" %>
  <% end %>
  <p><%= link_to "Criar conta", signup_path %></p>
</section>
