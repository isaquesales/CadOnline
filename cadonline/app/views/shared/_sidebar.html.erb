<aside class="sidebar">
  <div class="nav-group">
    <div class="nav-label">Ações</div>
    <%= button_to "Novo documento", documents_path, method: :post, class: "nav-item" %>
  </div>

  <div class="nav-group">
    <div class="nav-label">Favoritos</div>
    <% Array(@sidebar_favorites).each do |doc| %>
      <%= link_to doc.title, root_path(document_id: doc.id), class: "nav-item" %>
    <% end %>
  </div>

  <div class="nav-group">
    <div class="nav-label">Documentos</div>
    <% Array(@sidebar_documents).each do |doc| %>
      <div class="doc-row">
        <a href="<%= root_path(document_id: doc.id) %>" class="nav-item <%= 'active' if @document&.id == doc.id %>">
          <span class="doc-title" contenteditable="true" data-doc-id="<%= doc.id %>"><%= doc.title %></span>
        </a>
        <%= button_to "×", document_path(doc), method: :delete, class: "doc-delete-btn", form: { data: { confirm: "Excluir este documento?" } } %>
      </div>
    <% end %>
  </div>
</aside>
